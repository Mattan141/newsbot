# Copy this file to ".env" and paste your Alpaca PAPER keys in.
# .env is in .gitignore, so it will never be pushed to GitHub.
ALPACA_API_KEY=your_paper_key_here
ALPACA_SECRET_KEY=your_paper_secret_here

# Safety switch: the bot refuses to touch a live (real money) account
# unless this is set to exactly "yes". Leave it as "no".
ALLOW_LIVE_TRADING=no
